POSTGRES_DB=voice_labs
POSTGRES_USER=voice_labs
POSTGRES_PASSWORD=local-only
POSTGRES_PORT=5432
VALKEY_PORT=6379
LIVEKIT_PORT=7880

# Shared local application settings. Keep the Platform and Runtime tokens identical.
PLATFORM_DATABASE_URL=postgresql+psycopg://voice_labs:local-only@localhost:5432/voice_labs
PLATFORM_RUNTIME_TOKEN=local-runtime-token-change-me
RUNTIME_PLATFORM_TOKEN=local-runtime-token-change-me
PLATFORM_API_URL=http://localhost:8000
RUNTIME_API_URL=http://localhost:8001
RUNTIME_PLATFORM_URL=http://localhost:8000
NEXT_PUBLIC_PLATFORM_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Web-app features whose backend support has landed; omit one to show it as "Coming soon".
NEXT_PUBLIC_CAPABILITIES=voicePreview,liveLatency,toolExecution,knowledgeSearch
# Browser origins allowed by Platform CORS (comma-separated). For a hosted frontend calling this local
# Platform (e.g. a workers.dev URL), set it to that origin and enable private-network
# preflights with PLATFORM_ALLOW_PRIVATE_NETWORK=1.
PLATFORM_WEB_ORIGIN=http://localhost:3000
PLATFORM_ALLOW_PRIVATE_NETWORK=0

# LiveKit development server in compose.yml uses devkey / secret.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# External provider credentials are required for real speech processing.
DEEPGRAM_API_KEY=
OPENAI_API_KEY=
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=
